# fleetq configuration — copy to $Q_ROOT/config.env (Q_ROOT defaults to the
# checkout) and edit.  Shell-sourceable KEY=VALUE; `#` starts a comment.
#
# Read by: bin/q (paths only), bin/qd (everything), lib/*.sh helpers, bin/fleet.
# Queue Python config keys can be overridden per invocation with an environment
# variable of the same name.  bin/fleet sources this file, so values set here
# override the shell environment.  Q_CONFIG=/path/to/file selects another file.
#
# Only the LOCAL section is needed for the laptop quickstart.  Every remote
# site is off or inert until you fill in its section.

# ============================================================== local box ===
Q_LOCAL_RESERVE_THREADS=2      # threads never handed to tasks (kept for you / the agents)
Q_LOCAL_RESERVE_MB=1024        # FLOOR of MemAvailable kept free ...
Q_LOCAL_RESERVE_PCT=15         # ... and at least this % of MemTotal; reserve = max(MB, PCT%)
Q_LOCAL_MAX_TASKS=8            # hard ceiling on concurrent local tasks
Q_LOCAL_NICE=15                # niceness for local tasks
Q_LOCAL_GPU_SLOTS=1            # concurrent `--gpu 1` local tasks (serialises; does not partition VRAM)
Q_MEM_GRACE_POLLS=2            # consecutive over-cap polls before a memory kill
Q_MAX_MEM_KILLS=2              # memory kill + requeue attempts before a task FAILS

# ================================================================= daemon ===
Q_CYCLE_SEC=60                 # scheduler cycle
Q_RSS_POLL_SEC=5               # memory/timeout watchdog poll inside a cycle
Q_PULL_INTERVAL_SEC=900        # at most one result pull per job per interval
Q_PULL_TIMEOUT=900             # result pulls only (many small files)
Q_GCLOUD_TIMEOUT=300           # control-plane calls
Q_SUBMIT_MAX_FAILS=3           # consecutive submit failures before a job FAILS loudly
Q_MAX_CHUNK_RETRIES=2          # on-demand resubmit rounds for a failed/preempted chunk
# `--site either` precedence.  Jobs under 4 tasks still prefer local first.
# Put the site you already pay for (rented boxes) before the one billed per use.
Q_EITHER_ORDER=local,vast,batch

# =========================================================== Google Batch ===
# Needs: gcloud CLI authenticated for the project, a GCS bucket, a container
# image the tasks run in.  Leave Q_PROJECT empty to keep Batch unused.
Q_PROJECT=                     # e.g. my-gcp-project
Q_REGION=us-central1
Q_BUCKET=                      # e.g. my-fleetq-bucket (no gs:// prefix)
Q_IMAGE=                       # e.g. us-central1-docker.pkg.dev/my-gcp-project/repo/base:v1
Q_GCLOUD=gcloud                # absolute path if gcloud is not on PATH
Q_GSUTIL=gsutil                # fallback transport for old SDKs only
Q_BATCH_CPU_CAP=32             # your CPUS_ALL_REGIONS quota; raise it here when the quota rises
Q_BATCH_MACHINE=e2-standard-8
Q_BATCH_MAXRETRY=0             # Batch's own retry; the queue does its own on-demand resubmit
Q_BATCH_EXTERNAL_IP=0          # 1 = one external IP per task VM (address quota permitting)
Q_STALL_WARN_SEC=1800          # warn when a chunk gets no VM for this long
Q_STALL_ABORT_SEC=7200         # ...delete + resubmit on demand after this long (0 = never)
Q_PULL_EXCLUDE_DIRS=           # `|`-separated dir names never pulled back from $OUT

# ============================================================ Vast.ai boxes ===
# Boxes come from `bin/fleet refresh` (vastai CLI) -> fleet_state/instances.env
# (IP<N>/PORT<N>).  Relative paths resolve against Q_ROOT.  qd reads the box list
# at START: restart qd after registering a new box.
Q_VAST_ENABLE=1                # inert while instances.env lists no boxes
Q_VAST_INSTANCES=fleet_state/instances.env
Q_VAST_USER=root
Q_VAST_REMOTE_ROOT=/workspace/qvast
Q_VAST_SSH_TIMEOUT=60
Q_VAST_CORE_CAP=61.4           # usable cores per box (its cgroup cpu.max, NOT nproc)
# Q_VAST_CORE_CAP_4=130        # per-box override, for a box whose loadavg includes other tenants
Q_VAST_PULL_TIMEOUT=14400
# How results come home: (empty) = direct rsync, gcs, cluster, r2.  See README.
Q_VAST_RELAY=
# --- gcs relay: box -> GCS -> local with a 1 h impersonated token -------------
Q_VAST_GCS_SA=                 # e.g. fleetq-relay@my-gcp-project.iam.gserviceaccount.com
Q_VAST_GCS_ZSTD=3
Q_VAST_GCS_ZSTD_THREADS=8
Q_VAST_GCS_CLEANUP=1           # delete the relay object after a verified unpack
Q_VAST_INPUTS_VIA_GCS=0        # 1 = ship staged control files via GCS too (rsync fallback)
# --- cluster relay (two hops through a login node; needs fleet/cluster_connect.sh)
Q_VAST_RELAY_HOST=             # e.g. user@login.cluster.example.edu
Q_VAST_RELAY_ROOT=             # e.g. /scratch/user/fleetq_relay
# --- r2 hop 2 (cluster -> Cloudflare R2 -> local) ------------------------------
# Q_VAST_R2_REMOTE=            # rclone remote:bucket; required for r2 relay
# Q_VAST_R2_PREFIX=qvast_relay
# Q_VAST_R2_EXPIRE=2h
# Q_VAST_R2_ZSTD=3
# Q_VAST_R2_ZSTD_THREADS=4
# Q_VAST_R2_CLEANUP=1           # delete relay object after verified unpack

# ============================================================== Vultr VMs ===
# Dedicated CPU-optimized VMs created and deleted by qd itself.  Off by default.
Q_VULTR_ENABLE=0
Q_VULTR_API_KEY_FILE=~/.config/fleetq/vultr/api-key          # 0600, owned by you
Q_VULTR_SSH_KEY=~/.config/fleetq/vultr/id_ed25519
Q_VULTR_SSH_KEY_ID_FILE=~/.config/fleetq/vultr/ssh-key-id
Q_VULTR_ALLOWED_PREFIXES=voc-c-
Q_VULTR_REGIONS=ewr,ord,dfw,atl,sea,lax,sjc,mia
Q_VULTR_OS_ID=1743             # Ubuntu 22.04 x64
Q_VULTR_CPU_CAP=32             # fleet-wide vCPU cap
Q_VULTR_MAX_VMS=1
Q_VULTR_RESERVE_MB=256
Q_VULTR_IDLE_SEC=60            # delete an idle owned VM after this long
Q_VULTR_BOOT_TIMEOUT=1200
Q_VULTR_TRANSFER_TIMEOUT=1800
Q_VULTR_TASKS_PER_SLOT=8
Q_VULTR_BUDGET_USD=50          # estimated committed-spend ceiling (not a provider cap)
Q_VULTR_EXPIRES_AT=            # ISO time with timezone after which nothing new is allocated
Q_VULTR_EXPIRY_MARGIN_SEC=3600
# Q_VULTR_PLAN=                 # optional fixed plan; --machine takes precedence
# Q_VULTR_DEFAULT_PLANS=        # optional vCPU:plan pairs, comma-separated
# Q_VULTR_IMAGE=                # container image; falls back to Q_IMAGE
# Q_VULTR_INPUTS_ROOT=          # local input source; defaults to $Q_ROOT/inputs
# Q_VULTR_INPUTS_SOURCE=local   # local or gcs (also falls back to gcs if local input is absent)

# ============================================== Slurm (wave tooling only) ===
# Used by `bin/fleet gen` for target: slurm stages (the queue adapter is a stub).
Q_SLURM_ACCOUNT=               # e.g. pi-mylab
Q_SLURM_PARTITION=             # e.g. gpu
Q_SLURM_MAX_JOBS=12            # per-user submit cap; surplus submissions are REJECTED, not queued
# Q_SLURM_GRES=gpu:1            # generated submit_slurm.sh resource request
# Q_SLURM_CONSTRAINT=           # default GPU constraint; stage sbatch.constraint wins
# FL_MODULE_BASELINE=slurm      # modules permitted in the submitting shell
# FL_SKIP_MODULE_GUARD=1        # bypass the generated script's module check

# ========================================================= fleet (bin/fleet) ===
FLEET_STATE=fleet_state        # instances.json/.env, destroyed.jsonl, durations.json
FLEET_WAVES=waves              # wave specs: waves/<wave_id>/spec.json|yaml
FLEET_PROJECT_REPO=            # your project repo, pushed to boxes by `fleet push-repo`
FLEET_REMOTE_REPO=/workspace/repo
FLEET_REMOTE_RUNROOT=/workspace/runs
FLEET_BOX_HOME=/root/fleet     # where box/lanes.sh + box/watchdog.sh live on a box
FLEET_ARCHIVE_HOST=            # where `fleet destroy` checks results are archived ("" = this machine)
FLEET_ARCHIVE_ROOT=            # runroot on that host, e.g. /scratch/user/runs
FLEET_CLUSTER_HOST=            # user@login-node for cluster_connect.sh
FLEET_NTFY_TOPIC=              # ntfy.sh topic for box-side alerts ("" = log only)
# FLEET_RUNROOT=                # local wave runroot; defaults to $Q_ROOT/runs
# RUNROOT=                      # direct override for local wave checks and pulls
# FLEET_REPO_EXCLUDES=          # extra rsync exclude options for push-repo
# FLEET_CLUSTER_PERSIST=24h     # cluster ControlMaster lifetime
# FLEET_PUSH_TARGET=            # refresh --push-to default
# FLEET_SCIENCE_PROCS=          # watcher regex for payload processes
# FLEET_WATCH_POLL_SEC=120      # gpu_box_watch and destroy_gate poll interval
# FLEET_CANCEL_SETTLE_SEC=60    # deadline worker wait after cancellation
# FL_PULL_WITNESSES=            # extra mutable files for generated pull pass 2
# FL_PYTHON=python3             # box preflight Python executable

# Invocation-only environment controls (not read from this config by qd):
# Q_DRY_RUN=1                   # disable real Batch, Vast and Vultr operations
# Q_FAKE_LIST=/path/to/list.json # fake Batch listing for offline tests
# Q_ECHO=1                      # echo qd log lines to stderr
# Q_PYTHON=python3              # interpreter for bin/q
